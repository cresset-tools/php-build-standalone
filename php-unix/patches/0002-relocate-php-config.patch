# Relocate scripts/php-config.in: replace build-time @-substitutions with
# runtime path computation from $0.
#
# Without this patch, configure bakes the Nix store path into php-config,
# so --prefix, --include-dir, --lib-dir, --man-dir, and --php-binary all
# return paths inside /nix/store/... that don't exist after relocation.
# Tools like phpize and pkg-config wrappers query php-config at runtime.
#
# Four groups of changes:
#   1. SED="@SED@" → SED=sed (PATH-discovered sed at runtime).
#      Top variable block: compute prefix at runtime from $0 instead of
#      @prefix@ / @datarootdir@ / @exec_prefix@.
#   2. include_dir / lib_dir: replace @includedir@ / @orig_libdir@ with
#      $prefix-relative paths.
#   3. man_dir: replace `eval echo @mandir@` with $prefix/share/man.
#   4. SAPI binary paths: replace @bindir@ with $prefix/bin.
--- a/scripts/php-config.in
+++ b/scripts/php-config.in
@@ -1,18 +1,19 @@
 #! /bin/sh

-SED="@SED@"
-prefix="@prefix@"
-datarootdir="@datarootdir@"
-exec_prefix="@exec_prefix@"
+SED=sed
+# PBS: compute prefix at runtime from $0; tarball is relocatable.
+prefix=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+datarootdir="$prefix/share"
+exec_prefix="$prefix"
 version="@PHP_VERSION@"
 vernum="@PHP_VERSION_ID@"
-include_dir="@includedir@/php"
-lib_dir="@orig_libdir@"
+include_dir="$prefix/include/php"
+lib_dir="$prefix/lib"
 includes="-I$include_dir -I$include_dir/main -I$include_dir/TSRM -I$include_dir/Zend -I$include_dir/ext -I$include_dir/ext/date/lib"
 ldflags="@PHP_LDFLAGS@"
 libs="@EXTRA_LIBS@"
 extension_dir="@EXTENSION_DIR@"
-man_dir=`eval echo @mandir@`
+man_dir="$prefix/share/man"
 program_prefix="@program_prefix@"
 program_suffix="@program_suffix@"
 exe_extension="@EXEEXT@"
@@ -28,10 +29,10 @@
 for sapi in $php_sapis; do
   case $sapi in
   cli)
-    php_cli_binary="@bindir@/${program_prefix}php${program_suffix}${exe_extension}"
+    php_cli_binary="$prefix/bin/${program_prefix}php${program_suffix}${exe_extension}"
     ;;
   cgi)
-    php_cgi_binary="@bindir@/${program_prefix}php-cgi${program_suffix}${exe_extension}"
+    php_cgi_binary="$prefix/bin/${program_prefix}php-cgi${program_suffix}${exe_extension}"
     ;;
   esac
 done
